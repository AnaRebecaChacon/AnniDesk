<?php
declare(strict_types=1);

session_set_cookie_params([
    'httponly' => true,
    'samesite' => 'Lax',
]);

session_start();

if (empty($_SESSION['user']['id'])) {
    header('Location: /');
    exit;
}

require_once __DIR__ . '/../app/config/database.php';

$pdo = getDatabaseConnection();

$sql = "
    SELECT
        t.id,
        t.ticket_number,
        t.title,
        t.status,
        t.priority,
        t.created_at,
        c.name AS category_name,
        u.full_name AS requester_name,
        a.full_name AS agent_name
    FROM tickets t
    LEFT JOIN categories c ON c.id = t.category_id
    LEFT JOIN users u ON u.id = t.requester_id
    LEFT JOIN users a ON a.id = t.assigned_agent_id
    ORDER BY t.created_at DESC
";

$tickets = $pdo->query($sql)->fetchAll(PDO::FETCH_ASSOC);

function h(?string $value): string
{
    return htmlspecialchars($value ?? '', ENT_QUOTES, 'UTF-8');
}

$statuses = [
    'open' => 'Abierto',
    'in_progress' => 'En progreso',
    'pending' => 'Pendiente',
    'resolved' => 'Resuelto',
    'closed' => 'Cerrado',
];

$priorities = [
    'low' => 'Baja',
    'medium' => 'Media',
    'high' => 'Alta',
    'urgent' => 'Urgente',
];
?>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gestión de tickets | HelpDesk</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <style>
        .tickets-wrap { max-width: 1200px; margin: 32px auto; padding: 0 20px; }
        .tickets-toolbar { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px; }
        .tickets-table-wrap { overflow-x:auto; background:#fff; border-radius:12px; padding:16px; }
        .tickets-table { width:100%; border-collapse:collapse; }
        .tickets-table th, .tickets-table td { padding:12px; text-align:left; border-bottom:1px solid #e5e7eb; }
        .tickets-table th { background:#f8fafc; }
        .tickets-table td { font-size:14px; }
        .ticket-link { color:#2563eb; font-weight:600; }
        .empty-state { padding:28px; text-align:center; }
        .action-link { display:inline-block; padding:10px 14px; border-radius:8px; background:#2563eb; color:white; text-decoration:none; }
    </style>
</head>
<body>
    <main class="tickets-wrap">
        <div class="tickets-toolbar">
            <div>
                <h1>Gestión de tickets</h1>
                <p>Solicitudes registradas en el sistema.</p>
            </div>
            <div>
                <a class="action-link" href="/tickets.php">+ Crear ticket</a>
                <a class="action-link" href="/dashboard.php">Volver al panel</a>
            </div>
        </div>

        <div class="tickets-table-wrap">
            <?php if (!$tickets): ?>
                <div class="empty-state">
                    <h2>Aún no hay tickets</h2>
                    <p>Cuando registres una solicitud, aparecerá aquí.</p>
                </div>
            <?php else: ?>
                <table class="tickets-table">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Título</th>
                            <th>Solicitante</th>
                            <th>Categoría</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th>Agente asignado</th>
                            <th>Creado</th>
                        </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($tickets as $ticket): ?>
                        <tr>
                            <td><?= h($ticket['ticket_number']) ?></td>
                            <td><?= h($ticket['title']) ?></td>
                            <td><?= h($ticket['requester_name']) ?></td>
                            <td><?= h($ticket['category_name'] ?? 'Sin categoría') ?></td>
                            <td><?= h($priorities[$ticket['priority']] ?? $ticket['priority']) ?></td>
                            <td><?= h($statuses[$ticket['status']] ?? $ticket['status']) ?></td>
                            <td><?= h($ticket['agent_name'] ?? 'Sin asignar') ?></td>
                            <td><?= h($ticket['created_at']) ?></td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            <?php endif; ?>
        </div>
    </main>
</body>
</html>
